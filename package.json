{
  "name": "gisalgo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GISAlgo 路网建模与拓扑构建系统(G2 组)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "prepare:data": "node --max-old-space-size=6144 --import tsx scripts/prepare-data.ts",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @gisalgo/web",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  }
}
